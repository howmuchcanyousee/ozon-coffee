{
  "expo": {
    "name": "Ozon Coffee",
    "slug": "ozon-coffee",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/ozon-coffee-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#005BFF",
        "foregroundImage": "./assets/ozon-coffee-adaptive.png",
        "monochromeImage": "./assets/ozon-coffee-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.maratique.coffeehouse",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "react-native-quick-crypto"
    ],
    "scheme": "coffeehouse",
    "backgroundColor": "#F2F3F5"
  }
}
